# 📦 Bağımlılıklar (Node.js ve React için)
node_modules/

# 🔐 Çevresel Değişkenler ve Gizli Bilgiler
# (MS SQL Server şifreleri, API anahtarları vb. bu dosyalarda kalmalı)
.env
.env.*
!.env.example

# 🏗️ React Derleme (Build) Çıktıları
build/
dist/

# 📝 Log Dosyaları (Backend logları ve hata çıktıları)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# 💻 Editör ve İşletim Sistemi Dosyaları
.vscode/
.idea/
.DS_Store
Thumbs.db

# 🧹 Geçici ve Cache Dosyaları
.eslintcache
.npm/
# Database backups must never be committed
*.bak
*.mdf
*.ldf

# Yerel çalışma notları (süreç kayıtları, kalan işler); repoya ve yayına girmez
notlar/
