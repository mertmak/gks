# Public entry point. API and Socket.IO go straight to the backend so it sees
# exactly one trusted proxy (TRUST_PROXY_HOPS=1) and the real client address.
{$GKS_SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy backend:3000
	}
	handle {
		reverse_proxy frontend:80
	}
}

# Extra names (e.g. www.gks.example.com) answer with a permanent redirect to the main
# address and get their own certificate. Unset, this is an HTTP-only placeholder that
# matches no real host, so no certificate is requested.
{$GKS_REDIRECT_ADDRESSES} {
	redir https://{$GKS_SITE_ADDRESS}{uri} permanent
}
