DB_SERVER=localhost
DB_PORT=5432
# PostgreSQL folds names to lower case; use lower-case letters, digits and _.
DB_NAME=gksdb
DB_USER=gks_app
DB_PASSWORD=
# Local development only; production always uses TLS with certificate verification.
DB_SSL=false
# CA certificate for verifying the database server (required with a private CA).
# DB_SSL_CA=/run/secrets/gks-db-ca.crt
JWT_SECRET=
PORT=3000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Shared API/browser business day; valid IANA zone. Does not convert stored SQL times.
# Restart the server and reload browser pages after changing this setting.
BUSINESS_TIMEZONE=Europe/Istanbul
ENABLE_SIMULATION=false
ENABLE_SETUP=false
# Set only when running behind exactly this many trusted reverse proxies.
# TRUST_PROXY_HOPS=1
# Read-only demo: immutable server setting; restart after changing it.
DEMO_MODE=false
DEMO_USERNAME=gks-demo
# Demo only: visitors may open a personal, writable copy (own PostgreSQL schema)
# that is dropped after SANDBOX_TTL_MIN minutes. Needs db:runtime-role run with
# SANDBOX_MODE=true (grants CREATE on the database to the runtime role).
SANDBOX_MODE=false
# SANDBOX_TTL_MIN=120
# SANDBOX_MAX=30
# Only for seed: set to the exact dedicated gksdemo_/gkstest_ DB_NAME.
# DEMO_SEED_CONFIRM=gksdemo_v1
# Installation CLI only; do not keep these in the normal runtime environment.
# RUNTIME_DB_USER=gks_app
# RUNTIME_DB_CONFIRM=gksdb
# Server-wide PostgreSQL role holding the runtime grants (default gks_runtime).
# RUNTIME_DB_ROLE=gks_runtime
